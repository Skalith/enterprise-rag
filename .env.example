# Copy to .env and edit. Never commit .env (it is in .gitignore).
# Values below match docker-compose.yml service names for in-container use.
# For host-side local dev, override the ports:
#   DATABASE_URL=postgresql://raguser:change-me@localhost:5433/enterprise_rag
#   REDIS_URL=redis://localhost:6380/0
#   QDRANT_URL=http://localhost:6333
#   S3_ENDPOINT=http://localhost:9000

# --- Core -------------------------------------------------------------------
ENV=development
LOG_LEVEL=INFO
# Long random value (32+ chars). Required in production.
SECRET_KEY=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRE_MIN=30
JWT_REFRESH_EXPIRE_DAYS=7
MAX_UPLOAD_MB=50
# Set to the nginx container IP (or your load balancer IP) so X-Forwarded-For
# is only trusted from the proxy. Leave blank in local dev without nginx.
# Example: TRUSTED_PROXY=172.18.0.1
TRUSTED_PROXY=

# --- Infrastructure ---------------------------------------------------------
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enterprise_rag
DATABASE_URL=postgresql://raguser:change-me@postgres:5432/enterprise_rag
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_docs
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=enterprise-rag-docs
S3_REGION=us-east-1

# --- LLM providers (at least one key, or Ollama) ----------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
NVIDIA_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=llama3

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=30
RATE_LIMIT_EVALUATION_PER_MIN=5

# --- Password reset ----------------------------------------------------------
# Link base for the email; outside production the token is echoed by
# /api/v1/auth/forgot-password when SMTP is not configured.
# Frontend runs on port 1357, backend on port 2357.
APP_BASE_URL=http://localhost:1357
PASSWORD_RESET_TTL_MIN=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# --- Celery -----------------------------------------------------------------
CELERY_TASK_ALWAYS_EAGER=false

# --- Langfuse (optional; app runs fine with blank keys) ---------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Seed script ------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_FULL_NAME=Super Admin
